# Local runtime files (generated on first run)
settings.json
apps_cache.json

# Backups created by the "replace text in file" command
*.bak

# Logs and local temp/scratch files
*.log
_*.py
logs/

# Brain config (local; no secrets, but keep out of git)
.env

# License / integrity files (GUI protection layer)
license.key
integrity.hash

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
